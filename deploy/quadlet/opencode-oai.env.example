# opencode-oai — environment for the Podman Quadlet unit.
#
# Copy to ~/.config/opencode-oai/opencode-oai.env and chmod 600 — this file
# holds API keys. Do not commit a filled-in copy.
#
# Format: systemd EnvironmentFile. KEY=value, one per line, no `export`, and no
# shell quoting/expansion — quotes are taken literally by podman.

# ── Upstream OpenCode connection ──────────────────────────────────────────────
OPENCODE_URL=http://localhost:4096
#OPENCODE_USERNAME=opencode
#OPENCODE_PASSWORD=
#OPENCODE_TIMEOUT_MS=600000
#OPENCODE_RETRY_COUNT=2
#OPENCODE_RETRY_DELAY_MS=2000

# ── Bridge behaviour ──────────────────────────────────────────────────────────
OPENCODE_OAI_PORT=5000
OPENCODE_OAI_DEFAULT_PROVIDER=github-copilot
OPENCODE_OAI_DEFAULT_MODEL=gpt-4o

# Bearer key required from clients. Leave unset to accept anonymous requests —
# with Network=host that exposes the bridge on every host interface, so set it.
#OPENCODE_OAI_API_KEY=change-me

#OPENCODE_OAI_HEARTBEAT_MS=15000
#OPENCODE_OAI_SESSION_TTL_HOURS=2
#OPENCODE_OAI_CLEANUP_INTERVAL_MS=3600000
#OPENCODE_OAI_IDEMPOTENCY_TTL_HOURS=24

# ── Logging ───────────────────────────────────────────────────────────────────
OPENCODE_OAI_LOG_LEVEL=Information

# Log prompt and completion *content* into the journal, not just metadata.
# Useful for debugging an editor plugin; off by default because prompts carry
# whatever source code the editor decided to send.
#OPENCODE_OAI_LOG_PROMPTS=true
#OPENCODE_OAI_LOG_PREVIEW_CHARS=500
